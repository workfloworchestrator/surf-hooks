{
  "name": "surf-hooks",
  "version": "1.0.0",
  "description": "SURF hooks and plugins for Claude Code and OpenCode: Python style enforcement and large-read shunting via shared Python hook scripts",
  "type": "module",
  "main": ".opencode/plugins/surf-hooks.ts",
  "exports": {
    ".": "./.opencode/plugins/surf-hooks.ts"
  },
  "files": [
    ".opencode/plugins",
    ".opencode/lib",
    "plugins"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "claude-code",
    "hooks",
    "python",
    "style"
  ],
  "license": "MIT",
  "dependencies": {
    "@opencode/plugin": "^2.3.2"
  },
  "scripts": {
    "test:plugins": "node --experimental-strip-types --test .opencode/lib/hooks.test.ts",
    "test:shunt": "python3 -m pytest plugins/surf-shunt"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
